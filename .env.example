# ── App (copy to .env.local). Leave Supabase blank to use the in-app mock backend. ──
# Inlined into the bundle at build time (web + native). Only these PUBLIC_* keys are read — see scripts/env.js.
# After changing them on native, restart Metro: npm start -- --reset-cache
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_ZALO_OA_ID=
# Public address of the web app (for video share links), e.g. https://app.thedu.vn
PUBLIC_WEB_URL=
# Hotline của trung tâm (gọi trực tiếp từ app). Để trống = ẩn nút gọi.
PUBLIC_HOTLINE=

# ── Edge Function `api` secrets — server-side only, NEVER put these in the app ──
# supabase secrets set --env-file supabase/.env.functions   (see supabase/README.md)
#
# ZALO_APP_ID=                   # Zalo app (developers.zalo.me) — enables automatic token refresh
# ZALO_APP_SECRET=               # app Secret Key (sent as the secret_key header to Zalo OAuth)
#   then store the first token pair once (SQL editor): select zalo_token_set('<access>', '<refresh>', <expires_in>);
# ZALO_OA_ACCESS_TOKEN=          # optional static token, used only if no token is stored in the database
# ZNS_ADMIN_TEMPLATE_ID=         # approved ZNS template: new-lead alert to admins
#
# Parent messages (CRM) — one approved ZNS template per message; params must match exactly:
# ZNS_TEMPLATE_CONFIRMATION=     # T+0   C_NAME, STUDENT_NAME, CAMPUS, TIME, PHONE   (old name ZNS_PARENT_TEMPLATE_ID still works)
# ZNS_TEMPLATE_REMINDER_24H=     # T-24h C_NAME, STUDENT_NAME, TIME, CAMPUS, VIDEO_URL
# ZNS_TEMPLATE_REMINDER_2H=      # T-2h  C_NAME, STUDENT_NAME, TIME, ADDRESS, MAPS_URL, PHONE
# ZNS_TEMPLATE_POST_TRIAL=       # T+2h  C_NAME, STUDENT_NAME, TEACHER_NOTE, VOUCHER, EXPIRY, PHONE
# WEB_URL=https://app.thedu.vn   # video link in the T-24h reminder (same as PUBLIC_WEB_URL)
# POST_TRIAL_VOUCHER=            # REAL offer text, e.g. "Giảm 10% học phí khóa đầu". Empty = post-trial message not sent
# POST_TRIAL_VOUCHER_DAYS=7      # voucher validity after the trial
# Student lifecycle after a course (daily 09:00 job, see supabase/sql/schedule_lifecycle_cron.sql):
# ZNS_TEMPLATE_COMPLETION_CERT=  # T+0   C_NAME, STUDENT_NAME, COURSE, CERT_CODE, CERT_URL
# ZNS_TEMPLATE_TEACHER_REVIEW=   # T+3   C_NAME, STUDENT_NAME, COURSE, TEACHER_NOTE, NEXT_COURSE
# ZNS_TEMPLATE_ALUMNI_DISCOUNT=  # T+7   C_NAME, STUDENT_NAME, VOUCHER, NEXT_COURSE, EXPIRY, PHONE
# ZNS_TEMPLATE_FINAL_CALL=       # T+14  C_NAME, STUDENT_NAME, NEXT_COURSE, PHONE
# ALUMNI_VOUCHER=                # REAL alumni offer, e.g. "Giảm 500.000đ học phí khóa tiếp theo". Empty = T+7 not sent
# ALUMNI_VOUCHER_DAYS=14         # offer validity after it is sent
# CRON_SECRET=                   # ≥ 24 random chars; same value in supabase/sql/schedule_reminders_cron.sql
# CENTRE_HOTLINE=0987xxxxxx      # shown to parents in that ZNS (template param PHONE)
# ZNS_MODE=development           # ZNS test mode while trying templates; remove (or "production") to go live
# ADMIN_WEBHOOK_URL=             # n8n / Google Chat / Slack incoming webhook (optional)
# ADMIN_CONTACTS=[{"name":"Thầy Tú","phone":"09xxxxxxxx","courses":["TOAN_TU_DUY","BOI_DUONG_TOAN_TV"]},{"name":"Cô Hường","phone":"09xxxxxxxx","courses":["TIEN_TIEU_HOC","LUYEN_CHU_DEP"]}]
