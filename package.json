{
  "name": "th-edu-companion",
  "displayName": "TH EDU Companion",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "typecheck": "tsc --noEmit",
    "bundle:check": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .tmp/android.bundle && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output .tmp/ios.bundle",
    "sql:bundle": "node scripts/build-sql-bundle.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react-native": "^0.441.0",
    "nativewind": "^4.1.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-haptic-feedback": "2.3.3",
    "react-native-image-picker": "7.1.2",
    "react-native-linear-gradient": "2.8.3",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-video": "6.4.5",
    "react-native-web": "~0.19.10",
    "tailwindcss": "^3.4.14",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "13.6.9",
    "@react-native-community/cli-platform-android": "13.6.9",
    "@react-native-community/cli-platform-ios": "13.6.9",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/metro-config": "0.74.87",
    "@react-native/typescript-config": "0.74.87",
    "@types/react": "~18.2.79",
    "@vitejs/plugin-react": "4.3.4",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-plugin-transform-inline-environment-variables": "0.4.4",
    "dotenv": "16.4.5",
    "postcss": "8.4.49",
    "typescript": "~5.3.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
